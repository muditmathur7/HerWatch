# HerWatch Environment Configuration
PROJECT_NAME=HerWatch API
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=herwatch-super-secure-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/herwatch

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://127.0.0.1:3000"]
